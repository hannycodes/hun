# Copy to .env.local and fill in from your Supabase project:
#   Project Settings -> Data API (project URL) and API keys (publishable anon key)
#
# The anon/publishable key is safe in the browser: every table is protected by
# Row Level Security. NEVER put the service_role key in this app or any client
# bundle. The service key stays in the Supabase dashboard only.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
